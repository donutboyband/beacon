{
  "name": "beacon",
  "version": "0.3.1",
  "description": "A guardrail for AI coding agents: per-branch front-end scope declarations, real-time flags on out-of-scope writes, and one-click revert before the PR.",
  "type": "module",
  "main": "src/main/main.js",
  "bin": {
    "beacon": "bin/beacon.mjs"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepare": "bun scripts/build.ts",
    "start": "bun run build && electron .",
    "test": "bun test",
    "typecheck": "tsc -p . && tsc -p scripts",
    "dist": "bun run build && electron-builder --mac",
    "pack": "bun run build && electron-builder --dir"
  },
  "author": "Stefan Rhoades",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oneseventy170/Beacon.git"
  },
  "homepage": "https://github.com/oneseventy170/Beacon#readme",
  "bugs": {
    "url": "https://github.com/oneseventy170/Beacon/issues"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.beacon.app",
    "productName": "Beacon",
    "files": [
      "src/**/*",
      "!src/engine/**",
      "out/**/*",
      "bin/**/*",
      "package.json",
      "!scripts"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "icons/lighthouse-glass-1024.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "afterPack": "./scripts/adhoc-sign.cjs"
  }
}
