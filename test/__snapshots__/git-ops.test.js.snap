// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`context getContext snapshot, in and out of a repo 1`] = `
{
  "branch": "main",
  "cwd": "<TMP>/work",
  "defaultBranch": "main",
  "dirty": false,
  "ghReady": true,
  "isRepo": true,
  "originUrl": "<TMP>/github.com/test/repo.git",
  "ownerRepo": "test/repo",
}
`;

exports[`branches listBranches: newest first, current/default flagged 1`] = `
{
  "branches": [
    {
      "current": false,
      "date": "<date>",
      "isDefault": false,
      "name": "newer",
      "oid": "<short-sha>",
      "upstream": "origin/newer",
    },
    {
      "current": false,
      "date": "<date>",
      "isDefault": false,
      "name": "older",
      "oid": "<short-sha>",
      "upstream": null,
    },
    {
      "current": true,
      "date": "<date>",
      "isDefault": true,
      "name": "main",
      "oid": "<short-sha>",
      "upstream": "origin/main",
    },
  ],
  "current": "main",
  "defaultBranch": "main",
}
`;

exports[`branches branchLog: this branch's commits with change counts 1`] = `
{
  "branch": "log-me",
