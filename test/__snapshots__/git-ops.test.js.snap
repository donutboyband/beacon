exports[`stashes stash, list, detail, rename, pop, drop: list 1`] = `
[
  "stash@{0}: WIP on main: <short-sha> initial",
  "stash@{1}: On main: wip one",
]
`;

exports[`stashes stash, list, detail, rename, pop, drop: after rename 1`] = `
[
  "stash@{0}: renamed",
  "stash@{1}: WIP on main: <short-sha> initial",
]
`;

